# API Keys
TAVILY_API_KEY=your_tavily_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
EXA_API_KEY=your_exa_api_key_here

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=agents
POSTGRES_URI=your password and host here, e.g., postgresql://postgres:password@localhost:5432/agents

# Nginx reverse proxy - host port that maps to the nginx container (port 80 inside).
# The whole app (UI + API + SSE streaming) is served through this port.
NGINX_PORT=8080

# Auth - JWT signing key. Keep JWT_SECRET long and random
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
JWT_SECRET=generate_a_long_random_value_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Predefined demo users seeded at startup (register page not implemented yet):
#   user1 / test1234   user2 / test1234   user3 / test1234
#   user4 / test1234   user5 / test1234
# They live in config.TEST_USERS.